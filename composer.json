{
  "name": "railroad/points",
  "type": "library",
  "description": "A user point tracking system, which is commonly used for tracking user XP, like in a video game.",
  "keywords": [
    "event",
    "data",
    "synchronizer",
    "sync"
  ],
  "license": "MIT",
  "prefer-stable": true,
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.9",
    "railroad/resora": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0.1",
    "phpunit/php-code-coverage": "^11.0.1",
    "orchestra/testbench": "^9.2"
  },
  "autoload": {
    "psr-4": {
      "Railroad\\Points\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Railroad\\Points\\Tests\\": "tests/"
    }
  }
}
